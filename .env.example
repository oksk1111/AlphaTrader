# ============================================================
# US-ETF-Sniper 환경변수 설정
# 이 파일을 .env 로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# === Broker / execution mode ===
BROKER=kis                        # 1단계: 기존 실주문 경로. Toss 주문 이관 전 변경 금지
MARKET_DATA_BROKER=toss           # Toss 실시간 shadow 수집
EXECUTION_MODE=shadow             # shadow | live (Toss 공식 모의 서버는 현재 문서에 없음)

# === Toss Securities Open API ===
# 실제 값은 저장소에 커밋하지 말고 서버 .env / GitHub Secrets에만 설정하세요.
TOSS_CLIENT_ID=your_client_id_here
TOSS_CLIENT_SECRET=your_client_secret_here
TOSS_ACCOUNT_SEQ=                 # 비우면 종합매매 계좌가 하나일 때 자동 선택
TOSS_BASE_URL=https://openapi.tossinvest.com

# === KIS rollback only ===
KIS_MOCK=False
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=01

# === AI / LLM API Keys ===
GEMINI_API_KEY=your_gemini_api_key

# Optional (없으면 Gemini만 사용)
GROK_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# === Telegram 알림 ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Dashboard ===
DASHBOARD_API_KEY=your_dashboard_key

# === Google OAuth (대시보드 로그인용, 선택) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
