# ============================================================
# US-ETF-Sniper 환경변수 설정
# 이 파일을 .env 로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# === 토스증권 Open API (v8.0 — 한국투자증권 API 는 제거됨) ===
# 발급: 토스증권 WTS > 설정 > Open API. 같은 화면의 '허용 IP 관리'에 서버 공인 IP 를
# 반드시 등록할 것 (미등록 IP 는 403 ip-not-allowed). 실제 값은 커밋하지 말 것.
TOSS_CLIENT_ID=your_client_id_here
TOSS_CLIENT_SECRET=your_client_secret_here
TOSS_ACCOUNT_SEQ=                 # 비우면 종합매매 계좌가 하나일 때 자동 선택
TOSS_BASE_URL=https://openapi.tossinvest.com
EXECUTION_MODE=shadow             # shadow = 주문 미전송(기본) | live = 실주문. 토스는 모의투자 서버 없음

# === AI / LLM API Keys ===
GEMINI_API_KEY=your_gemini_api_key

# Optional (없으면 Gemini만 사용)
GROK_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# === Telegram 알림 ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Dashboard ===
DASHBOARD_API_KEY=your_dashboard_key
LOGIN_PASSWORD=                   # 대시보드 비밀번호 로그인 (미설정 시 비활성)

# === Google OAuth (대시보드 로그인용, 선택) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
