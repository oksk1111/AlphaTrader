# ============================================================
# US-ETF-Sniper 환경변수 설정
# 이 파일을 .env 로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# === 토스증권 Open API (v8.0 — 한국투자증권 API 는 제거됨) ===
# 발급: 토스증권 WTS > 설정 > Open API. 같은 화면의 '허용 IP 관리'에 서버 공인 IP 를
# 반드시 등록할 것 (미등록 IP 는 403 ip-not-allowed). 실제 값은 커밋하지 말 것.
TOSS_CLIENT_ID=your_client_id_here
TOSS_CLIENT_SECRET=your_client_secret_here
TOSS_ACCOUNT_SEQ=                 # 비우면 종합매매 계좌가 하나일 때 자동 선택
TOSS_BASE_URL=https://openapi.tossinvest.com
EXECUTION_MODE=shadow             # shadow = 주문 미전송(기본) | live = 실주문. 토스는 모의투자 서버 없음
# live 주문은 별도 릴리스 게이트를 통과해야 한다. 32바이트 이상 무작위 값을 GitHub Secret으로 관리.
LIVE_GATE_SECRET=

# === AI / LLM API Keys ===
GEMINI_API_KEY=your_gemini_api_key

# Optional (없으면 Gemini만 사용)
GROK_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# === Telegram 알림 ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Dashboard ===
# 운영에서는 HTTPS reverse proxy 뒤에서 Google OAuth + 허용 이메일을 사용하세요.
# DASHBOARD_API_KEY 는 헤더/URL 전달 시 노출될 수 있으므로 비상용으로만 보관하고 공유하지 마세요.
DASHBOARD_API_KEY=
LOGIN_PASSWORD=                   # 비상용 비밀번호 로그인. Google OAuth 운영 시 비워 두는 것을 권장
JWT_SECRET=                        # 32바이트 이상 무작위 값. 서버 재시작 후에도 OAuth 세션을 유지하려면 필수
DASHBOARD_COOKIE_SECURE=true       # HTTPS 운영은 true. 로컬 HTTP 개발만 false

# === Google OAuth (대시보드 로그인용) ===
# OAUTH_REDIRECT_URI 는 Google Cloud Console 의 승인된 리디렉션 URI와 정확히 일치해야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://dashboard.example.com/auth/callback
ALLOWED_EMAILS=operator@example.com  # 쉼표 구분 allowlist. 비우면 OAuth 로그인을 전부 거부
